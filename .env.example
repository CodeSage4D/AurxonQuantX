# AURXON QUANT - Environment Configuration Template
# Copy this file to .env and provide your private keys.
# NEVER commit .env to source control!

# Environment mode: 'development', 'testing', or 'production'
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost

# Database (Default: SQLite local WAL mode)
# For PostgreSQL with pgvector, set: postgresql+asyncpg://user:password@localhost:5432/aurxon
DATABASE_URL=sqlite+aiosqlite:///data/aurxon.sqlite

# LLM Providers (Optional for testing; fallback to deterministic heuristic mock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Financial & Search API Providers (Optional; fallback to public exchange disclosures & Yahoo Finance)
TAVILY_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# Risk & Trading Controls (Hard limits)
ENABLE_REAL_TRADING=false
PAPER_TRADING_INITIAL_CAPITAL=1000000.00 # INR (10 Lakhs)
MAX_POSITION_SIZE_PERCENT=10.0
MAX_DRAWDOWN_LIMIT_PERCENT=15.0
